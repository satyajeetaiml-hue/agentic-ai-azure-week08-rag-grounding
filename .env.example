APP_ENV=local
LOG_LEVEL=INFO

# ── Azure AI Search (set both to enable the search backend) ──────────────
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX=clinical-policies

# ── Foundry (grounded generation + query/document embeddings) ────────────
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=gpt-4o
# Embedding deployment enables hybrid (keyword + vector) retrieval.
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
