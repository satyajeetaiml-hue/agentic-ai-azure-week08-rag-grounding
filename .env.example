APP_ENV=local
LOG_LEVEL=INFO

# ── Azure AI Search (set both to enable the search backend) ──────────────
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX=clinical-policies

# ── Foundry (optional — used to generate the grounded answer) ────────────
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=gpt-4o
